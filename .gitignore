*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/

# Test / coverage tooling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pyre/
.pytype/

# =============================================================================
#  Node / frontend
# =============================================================================

# Dependencies
node_modules/

# Build outputs (Vite)
frontend/dist/
frontend/.vite/
