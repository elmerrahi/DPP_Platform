# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# =============================================================================
#  Environment / secrets
# =============================================================================
#
# Rule: never commit a real .env. Only .env.example (placeholder values) is OK.

.env
.env.*
!.env.example
!.env.*.example

